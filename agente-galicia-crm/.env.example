# Copia este ficheiro para /etc/agente-galicia-crm/.env na VPS e preenche os valores reais.
# NUNCA commitar o .env real no repositório.

NODE_ENV=production
HOST=127.0.0.1
PORT=8790

# true em HTTPS publico; false permite testar via tunel SSH http://127.0.0.1.
COOKIE_SECURE=true

# Caminho da base de dados no volume grande (dados persistentes).
DATABASE_URL=/mnt/donotact-data/agente-galicia-crm/data/contacts.sqlite

# Token para o Codex / integrações chamarem a API (header: Authorization: Bearer <token>).
# Gerar na VPS com: openssl rand -hex 32
CRM_API_TOKEN=GERAR_TOKEN_FORTE

# Segredo da sessão de login (Andre/Cristina no browser).
# Gerar na VPS com: openssl rand -hex 32
SESSION_SECRET=GERAR_SECRET_FORTE

# Password de cada utilizador — gerar na VPS com:
#   cd /opt/agente-galicia-crm/app && npm run hash-password -- "a-password-do-andre"
#   cd /opt/agente-galicia-crm/app && npm run hash-password -- "a-password-da-cristina"
# Cada comando imprime PASSWORD_SALT e PASSWORD_HASH — copiar para as linhas abaixo.
ANDRE_PASSWORD_SALT=
ANDRE_PASSWORD_HASH=
CRISTINA_PASSWORD_SALT=
CRISTINA_PASSWORD_HASH=
